# build effort
node_modules/
dist/
.turbo/
*.tsbuildinfo

# Continuous Native Generation (ADR-0006): ios/ and android/ are GENERATED by
# `expo prebuild`, never authored. Committing them would make the native
# projects a second source of truth that app.json and the config plugins then
# silently disagree with.
apps/*/ios/
apps/*/android/
apps/*/.expo/

# Flutter (ADR-0012): the native runners are REAL, authored projects — the
# opposite of the Expo CNG rule above, which dies with apps/driver.
!apps/driver_flutter/ios/
!apps/driver_flutter/android/
.dart_tool/
packages/dart/*/pubspec.lock
